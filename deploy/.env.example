# LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Embeddings (falls back to OPENAI_API_KEY / OPENAI_BASE_URL if not set)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Deployment: only the web port is published on the host loopback interface.
WEB_PORT=8080
# Set this to science-agent-rag_milvus when adopting the old Compose volume.
MILVUS_VOLUME_NAME=science-agent-milvus
MILVUS_VOLUME_EXTERNAL=false
MILVUS_COLLECTION=science_web_papers

# VLM — vision analysis for figures (falls back to OPENAI_API_KEY / OPENAI_BASE_URL if not set)
VLM_API_KEY=
VLM_BASE_URL=
VLM_MODEL=gpt-4.1-mini

# Reranker (falls back to OPENAI_API_KEY / OPENAI_BASE_URL if not set)
RERANK_API_KEY=
RERANK_BASE_URL=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_ENDPOINT=/rerank
